# 放到 /etc/systemd/system/astock-scheduler.service
# 定时任务单独一个进程，且必须是单实例——多份调度器会让同一个 agent
# 被并发决策、重复下单、重复写教训。
[Unit]
Description=A股观察台 · 定时任务 (agent 日循环 / 复盘 / 数据回填)
After=network-online.target astock-web.service
Wants=network-online.target

[Service]
Type=simple
User=astock
Group=astock
WorkingDirectory=/opt/astock
Environment="ASTOCK_ENV=production"
Environment="PATH=/opt/astock/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/astock/.venv/bin/python3 scheduler.py
Restart=always
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/astock
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true

LimitNOFILE=4096
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
