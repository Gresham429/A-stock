# 复制成 .env 并填好。这个文件绝不能进 git（.gitignore 已排除）。
# 服务器上权限必须是 600：chmod 600 /opt/astock/.env

# ── AI（必填）──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-填你的key
DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 联网搜索（可选，填了才启用）─────────────────────────────
# BOCHAAI_API_KEY=sk-xxxx

# ── 部署 ──────────────────────────────────────────────────
ASTOCK_ENV=production
# 每台机器一个，deploy.sh 会自动生成，不要手填也不要跨机器复用
# ASTOCK_SECRET_KEY=

# ── 登录与会话 ────────────────────────────────────────────
ASTOCK_SESSION_DAYS=14          # 登录多久失效
ASTOCK_COOKIE_SECURE=1          # 走 https 必须是 1；只有本机裸 http 调试才改 0
ASTOCK_MAX_LOGIN_FAILS=5        # 连错几次锁定
ASTOCK_LOGIN_LOCK_SEC=300       # 锁多久（秒）

# ── 限流：保护 DeepSeek 余额 ───────────────────────────────
# 按「次数」而不是 token 封顶，因为次数才挡得住失控的循环。
# 先按人头算一算：几个人 × 每人每天点几次 AI，宽松一点设，观察一周再收紧。
ASTOCK_AI_PER_USER_DAY=40       # 每人每天最多几次 AI 分析
ASTOCK_AI_GLOBAL_DAY=150        # 全站每天封顶（余额的最后一道保险）
ASTOCK_AI_MIN_INTERVAL=6        # 同一人两次 AI 调用的最小间隔（秒），挡连点
ASTOCK_HEAVY_PER_USER_DAY=20    # 全市场池刷新/回测这类重任务，每人每天上限
ASTOCK_REQ_PER_MIN=180          # 每人每分钟总请求数，挡失控的前端轮询

# ── 进程 ──────────────────────────────────────────────────
ASTOCK_WORKERS=2                # 几个人用，2 个 worker 足够
ASTOCK_THREADS=8
ASTOCK_TIMEOUT=300              # 每日推荐要跑 20~40 秒，不能设太短
ASTOCK_AGENT_TICK_SEC=300       # agent 日循环心跳间隔
REVIEW_AUTO_TIME=18:30          # 每日复盘自动生成时刻
