# 复制成 .env 并填好。这个文件绝不能进 git（.gitignore 已排除）。
# 服务器上权限 640、属主 root:astock（deploy/fix_perms.sh 会设）：
# systemd 以 root 读 EnvironmentFile，config.py 由 astock 进程读，其他账号读不到。
#
# 格式：每行 KEY=value，注释单独占一行。config.py 和 systemd 的 EnvironmentFile
# 都不会剥掉值后面的「# 注释」，写在同一行会把注释当成值的一部分。

# ── AI（必填）──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-填你的key
DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 联网搜索（可选，填了才启用）─────────────────────────────
# BOCHAAI_API_KEY=sk-xxxx

# ── 部署 ──────────────────────────────────────────────────
# production 时 cookie 默认带 Secure 标记（只走 https）
ASTOCK_ENV=production
# 每台机器一个，deploy.sh 会自动生成，不要手填也不要跨机器复用
# ASTOCK_SECRET_KEY=

# ── agent 舰队 ────────────────────────────────────────────
# 留空取最早创建的管理员（机制见仓库根 CLAUDE.md「多用户与部署」节）
ASTOCK_FLEET_OWNER=
# 服务器上默认不自动跑；设 1 才让 scheduler.py 按盘中时段桶自动跑舰队，
# 本地 python3 app.py 不看这个开关。
ASTOCK_AGENT_AUTO=0

# ── 登录与会话 ────────────────────────────────────────────
# 登录多久失效
ASTOCK_SESSION_DAYS=14
# cookie 的 Secure 标记由 ASTOCK_ENV=production 决定，不用单独设。
# 只有想在 production 下走裸 http 调试时才解开并设 0。
# ASTOCK_COOKIE_SECURE=0
# 连错几次锁定
ASTOCK_MAX_LOGIN_FAILS=5
# 锁多久（秒）
ASTOCK_LOGIN_LOCK_SEC=300

# ── 限流：保护 DeepSeek 余额 ───────────────────────────────
# 按「次数」而不是 token 封顶，因为次数才挡得住失控的循环。
# 先按人头算一算：几个人 × 每人每天点几次 AI，宽松一点设，观察一周再收紧。
# 每人每天最多几次 AI 分析
ASTOCK_AI_PER_USER_DAY=40
# 全站每天封顶（余额的最后一道保险）
ASTOCK_AI_GLOBAL_DAY=150
# 同一人两次 AI 调用的最小间隔（秒），挡连点
ASTOCK_AI_MIN_INTERVAL=6
# 全市场池刷新/回测这类重任务，每人每天上限
ASTOCK_HEAVY_PER_USER_DAY=20
# 每人每分钟总请求数，挡失控的前端轮询
ASTOCK_REQ_PER_MIN=180

# ── 进程 ──────────────────────────────────────────────────
# 几个人用，2 个 worker 足够
ASTOCK_WORKERS=2
ASTOCK_THREADS=8
# 每日推荐要跑 20~40 秒，不能设太短
ASTOCK_TIMEOUT=300
# agent 日循环心跳间隔（秒）。仅 scheduler.py 使用；本地 python3 app.py 的心跳固定 300 秒
ASTOCK_AGENT_TICK_SEC=300
# gunicorn 监听地址，只监听回环，由 tailscale serve / nginx 转进来
# ASTOCK_BIND=127.0.0.1:5000
# gunicorn 日志级别（debug / info / warning / error）
# ASTOCK_LOG_LEVEL=INFO
# 每日复盘自动生成时刻
REVIEW_AUTO_TIME=18:30

# ── 备份（deploy/backup.sh 会 source .env 读这三项）─────────────
# 本地快照保留天数
ASTOCK_BACKUP_KEEP=14
# 备份文件落盘目录
ASTOCK_BACKUP_DIR=/var/backups/astock
# 可选：装了 ossutil/ossutil64 并配好 config 才会生效，异地备份到阿里云 OSS
# ASTOCK_OSS_BUCKET=你的bucket名
